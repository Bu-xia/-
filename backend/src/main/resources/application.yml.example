server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/study_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: "123456"
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    open-in-view: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

jwt:
  secret: study-platform-jwt-secret-key-please-change-2026
  expire-hours: 72

qwen:
  # 在此填入你的通义千问（DashScope）API Key
  api-key: ""
  model: qwen-plus
  base-url: https://dashscope.aliyuncs.com/compatible-mode/v1

file:
  upload-dir: ./uploads
